<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoşgeldin!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#3D2C2C"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bugün nasıl?"
        android:textSize="20sp"
        android:textColor="#3D2C2C"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvGreeting"/>

    <LinearLayout
        android:id="@+id/layoutOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/tvQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnTired"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Yorgun"
            android:textSize="16sp"
            android:backgroundTint="#FFE4D6"
            android:textColor="#3D2C2C"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnSick"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Hasta / Halsiz"
            android:textSize="16sp"
            android:backgroundTint="#FFE4D6"
            android:textColor="#3D2C2C"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnPlayful"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Oyuncu"
            android:textSize="16sp"
            android:backgroundTint="#FFE4D6"
            android:textColor="#3D2C2C"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnAngry"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Kızgın / Huysuz"
            android:textSize="16sp"
            android:backgroundTint="#FFE4D6"
            android:textColor="#3D2C2C"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnHappy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Sakin / Mutlu"
            android:textSize="16sp"
            android:backgroundTint="#FFE4D6"
            android:textColor="#3D2C2C"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnViewReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Raporları Gör"
        android:textSize="16sp"
        android:backgroundTint="#C47B5A"
        android:textColor="#FFFFFF"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutOptions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>