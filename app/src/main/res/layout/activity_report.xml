<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvReportTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Raporlar"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#3D2C2C"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvDailyReportTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gunluk Rapor"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#C47B5A"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/tvReportTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/scrollDaily"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDailyReportTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvDailyReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#3D2C2C"
            android:lineSpacingExtra="6dp"
            android:padding="12dp"
            android:background="#FFFFFF"/>

    </ScrollView>

    <TextView
        android:id="@+id/tvWeeklyReportTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Haftalik Rapor"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#C47B5A"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/scrollDaily"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/scrollWeekly"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvWeeklyReportTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvWeeklyReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#3D2C2C"
            android:lineSpacingExtra="6dp"
            android:padding="12dp"
            android:background="#FFFFFF"/>

    </ScrollView>

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ana Sayfaya Don"
        android:textSize="16sp"
        android:backgroundTint="#C47B5A"
        android:textColor="#FFFFFF"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/scrollWeekly"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>